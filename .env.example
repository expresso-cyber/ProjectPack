# Server
PORT=3001
NODE_ENV=development

# Where ProjectPack stores its own metadata, jobs, packages, and downloaded
# GitHub sources (never user sources). Default: ~/.projectpack (outside any
# codebase). Set this to move all generated data somewhere else.
# DATA_DIR=./data

# Python file engine
PYTHON_BIN=python3
PYTHON_ENGINE_PATH=python/file_engine

# Limits for safety
MAX_FILES=20000
MAX_FILE_BYTES=52428800

# Optional AI prompt enhancement (ADR-007: opt-in only; any OpenAI-compatible endpoint)
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Website import limits
WEBSITE_MAX_PAGES=30
WEBSITE_MAX_ASSETS=400
WEBSITE_MAX_TOTAL_BYTES=104857600
WEBSITE_TIMEOUT_MS=20000
WEBSITE_REQUEST_DELAY_MS=100
WEBSITE_CONCURRENCY=6

# Reserved for later stages (see docs/10_TECH_STACK_AND_TOOLS.md)
# MONGODB_URI=mongodb://localhost:27017/projectpack
# REDIS_URL=redis://localhost:6379
# GITHUB_TOKEN=

# ---- Small-host / memory tuning (Render free tier = 512 MB) ----
# Each concurrent Python batch is a separate process; lower these if the host
# runs out of memory during extraction or hashing.
EXTRACT_CONCURRENCY=2
HASH_CONCURRENCY=2

# Fallback proxy used when a site blocks the server's IP (403/451 or a network
# error). {url} is replaced with the encoded target. Set empty to disable.
WEBSITE_FALLBACK_PROXY=https://api.allorigins.win/raw?url={url}
# Crawler User-Agent (browser-compatible by default; some hosts reject bots).
# WEBSITE_USER_AGENT=

